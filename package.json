    "react-dom": "^19.0.0",
    "react-router": "^8.0.0"
  },  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@react-router/dev": "^8.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  }
